                                                                                        </div>
                                                                                    </div>
                                                                                </div>


@code {
    private List<Producto> productos = new();
    private List<Datos_Productos> datosproductos = new();
    private Producto producto = new Producto();
    private int idProductoEliminar = 0;
    private List<Categorias> categorias = new();
    private List<Proveedores> proveedores = new();
    private List<ProductoAlertaStock> productosAlerta = new();


    protected override async Task OnInitializedAsync()
    {
        datosproductos = await Http.GetFromJsonAsync<List<Datos_Productos>>("api/DataAccess/productosdatos")
                    ?? new List<Datos_Productos>();
        productos = await Http.GetFromJsonAsync<List<Producto>>("api/DataAccess/productos")
            ?? new List<Producto>();
        categorias = await Http.GetFromJsonAsync<List<Categorias>>("api/DataAccess/categorias") ?? new();

        proveedores = await Http.GetFromJsonAsync<List<Proveedores>>("api/DataAccess/proveedores") ?? new();
         productosAlerta = await Http.GetFromJsonAsync<List<ProductoAlertaStock>>(
            "api/DataAccess/productos-alerta-stock"
        ) ?? new();
    }
    private MovimientoRequest movimiento = new()
    {
        tipoMovimiento = "entrada",
    };
    private async Task RegistrarMovimiento()
    {
        if (movimiento.idProducto == 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Producto no seleccionado",
                Text = "Debes seleccionar un producto para registrar el movimiento",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido"
            });

            return;
        }
        if (movimiento.cantidad <= 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Cantidad inválida",
                Text = "Debes ingresar una cantidad mayor a 0.",
                Icon = SweetAlertIcon.Warning,
                ConfirmButtonText = "Entendido"
            });

            return;
        }
        var response = await Http.PostAsJsonAsync(
    "api/DataAccess/movimiento", movimiento);

        if (response.IsSuccessStatusCode)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "¡Movimiento registrado!",
                Text = "La salida del producto se registró correctamente.",
                Icon = SweetAlertIcon.Success,
                ConfirmButtonText = "Aceptar"
            });
            productos = await Http.GetFromJsonAsync<List<Producto>>("api/DataAccess/productos")
                ?? new List<Producto>();
            datosproductos = await Http.GetFromJsonAsync<List<Datos_Productos>>("api/DataAccess/productosdatos")
        ?? new List<Datos_Productos>();
        }
        else
        {
            // Obtener mensaje de error de la API
            var mensajeError = await response.Content.ReadAsStringAsync();

            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "No se pudo registrar",
                Text = mensajeError,
                Icon = SweetAlertIcon.Error,
                ConfirmButtonText = "Aceptar"
            });
        }
    }
    private async Task CreationProduct()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
        "api/DataAccess/productos", producto);
            if (response.IsSuccessStatusCode)
            {
                producto = new Producto();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Producto Registrado!",
                    Text = "Tu producto fue guardado correctamente.",
                    Icon = SweetAlertIcon.Success
                });
                productos = await Http.GetFromJsonAsync<List<Producto>>(
    "api/DataAccess/productos"
                ) ?? new List<Producto>();
                datosproductos = await Http.GetFromJsonAsync<List<Datos_Productos>>("api/DataAccess/productosdatos")
?? new List<Datos_Productos>();
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo registrar el producto.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error al registrar el producto: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private async Task DeleteProduct()
    {
        if (idProductoEliminar == 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Selecciona un producto",
                Text = "Debes seleccionar un producto antes de eliminarlo.",
                Icon = SweetAlertIcon.Warning
            });

            return;
        }
        try
        {
            var response = await Http.DeleteAsync($"api/DataAccess/deleteproduct/{idProductoEliminar}");

            if (response.IsSuccessStatusCode)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Producto eliminado!",
                    Text = "El producto fue eliminado correctamente.",
                    Icon = SweetAlertIcon.Success
                });
                idProductoEliminar = 0;

                datosproductos = await Http.GetFromJsonAsync<List<Datos_Productos>>(
                    "api/DataAccess/productosdatos"
                ) ?? new List<Datos_Productos>();
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo eliminar el producto.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private async Task UpdateProduct()
    {
        if (producto.id_producto == 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Selecciona un producto",
                Text = "Debes seleccionar un producto antes de actualizarlo.",
                Icon = SweetAlertIcon.Warning
            });

            return;
        }
        try
        {
            var response = await Http.PutAsJsonAsync(
                $"api/DataAccess/updateproduct/{producto.id_producto}",
                producto
            );

            if (response.IsSuccessStatusCode)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Producto actualizado!",
                    Text = "Los cambios se guardaron correctamente.",
                    Icon = SweetAlertIcon.Success
                });

                datosproductos = await Http.GetFromJsonAsync<List<Datos_Productos>>(
                    "api/DataAccess/productosdatos"
                ) ?? new List<Datos_Productos>();
                producto = new Producto();

                productos = await Http.GetFromJsonAsync<List<Producto>>(
                    "api/DataAccess/productos"
                ) ?? new List<Producto>();
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo actualizar el producto.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private async Task CargarProducto()
    {
        if (producto.id_producto == 0)
            return;

        var response = await Http.GetAsync(
            $"api/DataAccess/producto/{producto.id_producto}"
        );

        if (response.IsSuccessStatusCode)
        {
            var productoEncontrado = await response.Content.ReadFromJsonAsync<Producto>();

            if (productoEncontrado != null)
            {
                producto = productoEncontrado;
            }
        }
    }
    public class MovimientoRequest
    {
        public int idProducto { get; set; }
        public string tipoMovimiento { get; set; } = "";
        public int cantidad { get; set; }
    }
    private void SeleccionarEntrada()
    {
        movimiento.tipoMovimiento = "entrada";
    }

    private void SeleccionarSalida()
    {
        movimiento.tipoMovimiento = "salida";
    }

    private void SeleccionarAjuste()
    {
        movimiento.tipoMovimiento = "ajuste";
    }
    
    public class ProductoAlertaStock
    {
        public int id_producto { get; set; }
        public string? nombre { get; set; }
        public double stock_actual { get; set; }
        public double stock_minimo { get; set; }
        public string? estado { get; set; }
    }
}