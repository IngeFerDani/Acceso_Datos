                                                                                <ValidationMessage For="@(() => producto.precio_venta)" />
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">Stock
                                                                                actual</label>
                                                                                <input type="number" @bind="producto.stock_actual" min="0"
