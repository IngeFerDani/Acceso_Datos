                        <span class="material-symbols-outlined fs-5">add_box</span>
        </div>
        <div>
            <h3 class="fs-5 fw-bold text-melody-on-surface mb-0 d-flex align-items-center gap-1">
                <span class="">🍓 ActualizarProveedor</span>
            </h3>
            <p class="text-melody-variant mb-0" style="font-size: 0.8rem;">Completa los datos del proveedor
                para
                actualizarlo en el inventario kawaii</p>
