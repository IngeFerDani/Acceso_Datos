@code {
    private List<Proveedores> proveedores = new();
    private Proveedores proveedor = new Proveedores();
    private Proveedores proveedorActualizar = new Proveedores();
     private int idProveedorActualizar = 0;
    private int idProveedorEliminar = 0;
    protected override async Task OnInitializedAsync()
    {
        proveedores = await Http.GetFromJsonAsync<List<Proveedores>>("api/DataAccess/proveedores")
         ?? new List<Proveedores>();
    }
    private async Task CreationCategory()
    {
        try
        {
            var response = await Http.PostAsJsonAsync(
        "api/DataAccess/proveedores", proveedor);
            if (response.IsSuccessStatusCode)
            {
                proveedor = new Proveedores();
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Proveedor Registrado!",
                    Text = "El proveedor fue registrado correctamente.",
                    Icon = SweetAlertIcon.Success
                });
                proveedores = await Http.GetFromJsonAsync<List<Proveedores>>("api/DataAccess/proveedores")
 ?? new List<Proveedores>();
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo registrar el proveedor.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error al registrar el proveedor: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private async Task UpdateProveedor()
    {
        if (idProveedorActualizar == 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Selecciona un proveedor",
                Text = "Debes seleccionar un proveedor antes de actualizarlo.",
                Icon = SweetAlertIcon.Warning
            });

            return;
        }
        try
        {
            proveedorActualizar.id_proveedor = idProveedorActualizar;
            var response = await Http.PutAsJsonAsync(
                $"api/DataAccess/updateproveedor/{idProveedorActualizar}",
                proveedorActualizar
            );

            if (response.IsSuccessStatusCode)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Proveedor actualizado!",
                    Text = "Los cambios se guardaron correctamente.",
                    Icon = SweetAlertIcon.Success
                });

            proveedores = await Http.GetFromJsonAsync<List<Proveedores>>(
                "api/DataAccess/proveedores")
                ?? new List<Proveedores>();

            // Limpiar formulario
            proveedorActualizar = new Proveedores();
            idProveedorActualizar = 0;
            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo actualizar el proveedor.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private async Task DeleteProveedor()
    {
        if (idProveedorEliminar == 0)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Selecciona un proveedor",
                Text = "Debes seleccionar un proveedor antes de eliminarlo.",
                Icon = SweetAlertIcon.Warning
            });

            return;
        }
        try
        {
            var response = await Http.DeleteAsync($"api/DataAccess/deleteproveedor/{idProveedorEliminar}");

            if (response.IsSuccessStatusCode)
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "¡Proveedor eliminado!",
                    Text = "El proveedor fue eliminado correctamente.",
                    Icon = SweetAlertIcon.Success
                });
                idProveedorEliminar = 0;
                proveedores = await Http.GetFromJsonAsync<List<Proveedores>>(
    "api/DataAccess/proveedores")
    ?? new List<Proveedores>();

            }
            else
            {
                await Swal.FireAsync(new SweetAlertOptions
                {
                    Title = "Error",
                    Text = "No se pudo eliminar el proveedor.",
                    Icon = SweetAlertIcon.Error
                });
            }
        }
        catch (Exception ex)
        {
            await Swal.FireAsync(new SweetAlertOptions
            {
                Title = "Error",
                Text = $"Ocurrió un error: {ex.Message}",
                Icon = SweetAlertIcon.Error
            });
        }
    }
    private void CargarProveedorActualizar()
{
    if (idProveedorActualizar == 0)
    {
        proveedorActualizar = new Proveedores();
        return;
    }

    var proveedorSeleccionado = proveedores
        .FirstOrDefault(p => p.id_proveedor == idProveedorActualizar);

    if (proveedorSeleccionado != null)
    {
        proveedorActualizar = new Proveedores
        {
            id_proveedor = proveedorSeleccionado.id_proveedor,
            nombre_empresa = proveedorSeleccionado.nombre_empresa,
            contacto_nombre = proveedorSeleccionado.contacto_nombre,
            telefono = proveedorSeleccionado.telefono,
            email = proveedorSeleccionado.email,
            direccion = proveedorSeleccionado.direccion
        };
    }
}

}