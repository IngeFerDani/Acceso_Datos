        </div>
        <EditForm Model="@proveedorActualizar" OnValidSubmit="UpdateProveedor" class="row g-3">
            <DataAnnotationsValidator />
            <div class="col-md-6">
                <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">seleecione un
