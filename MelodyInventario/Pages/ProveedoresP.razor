                        <input type="text" @bind="proveedorActualizar.nombre_empresa"
                                class="form-control form-control-sm rounded-pill border-melody-pink bg-melody-surface-low px-3"
                                placeholder="MEL-0521">
                        <ValidationMessage For="@(() => proveedorActualizar.nombre_empresa)" />
                    </div>
                     <div class="col-md-4">
                    <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">Nombre de la Categoría</label>
                        <input type="text" @bind="proveedorActualizar.contacto_nombre"
                                class="form-control form-control-sm rounded-pill border-melody-pink bg-melody-surface-low px-3"
                                placeholder="MEL-0521">
                        <ValidationMessage For="@(() => proveedorActualizar.contacto_nombre)" />
                    </div>
                    <div class="col-md-4">
                    <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">Nombre de la Categoría</label>
                        <input type="text" @bind="proveedorActualizar.telefono"
                                class="form-control form-control-sm rounded-pill border-melody-pink bg-melody-surface-low px-3"
                                placeholder="MEL-0521">
                        <ValidationMessage For="@(() => proveedorActualizar.telefono)" />
                    </div>
                    <div class="col-md-6">
                    <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">Nombre de la Categoría</label>
                        <input type="text" @bind="proveedorActualizar.email"
                                class="form-control form-control-sm rounded-pill border-melody-pink bg-melody-surface-low px-3"
                                placeholder="MEL-0521">
                        <ValidationMessage For="@(() => proveedorActualizar.email)" />
                    </div>
                    <div class="col-md-6">
                    <label class="form-label fw-bold text-melody-variant" style="font-size: 0.76rem;">Nombre de la Categoría</label>
                        <input type="text" @bind="proveedorActualizar.direccion"
                                class="form-control form-control-sm rounded-pill border-melody-pink bg-melody-surface-low px-3"
