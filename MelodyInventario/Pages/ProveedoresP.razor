@page "/proveedores"
@using MelodyInventario.Models
@inject SweetAlertService Swal
@inject HttpClient Http

<div class="card border-0 rounded-4 shadow-soft p-4 mb-4 position-relative overflow-hidden"
     style="background-color: var(--melody-surface-low);">
    <!-- Ambient glowing circles -->
